[{
 "html": "{% set company = frappe.db.get_single_value('Global Defaults', 'default_company') %}\n<div style=\"font-family:-apple-system,Segoe UI,Roboto,Arial,sans-serif;max-width:760px;margin:0 auto;color:#1c1e26\">\n  <div style=\"display:flex;justify-content:space-between;align-items:center;border-bottom:3px solid #4f8cff;padding-bottom:14px\">\n    <div>\n      <h1 style=\"margin:0;font-size:24px;color:#111\">{{ company or 'Company' }}</h1>\n      <div style=\"font-size:12px;color:#8a8f98\">Proof of Delivery</div>\n    </div>\n    <div style=\"text-align:right\">\n      <div style=\"font-size:20px;font-weight:700;color:#4f8cff\">{{ doc.name }}</div>\n      <div style=\"font-size:13px;color:#8a8f98\">{{ frappe.utils.format_datetime(doc.delivery_datetime) }}</div>\n    </div>\n  </div>\n\n  <table style=\"width:100%;border-collapse:collapse;margin-top:18px;font-size:13px\">\n    <tr>\n      <td style=\"width:50%;padding:8px;border:1px solid #e2e6ee;vertical-align:top\">\n        <b>Shipment</b><br>\n        <a href=\"{{ frappe.utils.get_url() }}/app/shipment/{{ doc.shipment }}\">{{ doc.shipment }}</a>\n      </td>\n      <td style=\"padding:8px;border:1px solid #e2e6ee;vertical-align:top\">\n        <b>Delivery Status</b><br>\n        <span style=\"color:{% if doc.delivery_status == 'Delivered' %}green{% elif doc.delivery_status == 'Failed' %}red{% else %}orange{% endif %};\">{{ doc.delivery_status }}</span>\n      </td>\n    </tr>\n    <tr>\n      <td style=\"padding:8px;border:1px solid #e2e6ee;vertical-align:top\">\n        <b>Customer</b><br>{{ doc.customer or '—' }}\n      </td>\n      <td style=\"padding:8px;border:1px solid #e2e6ee;vertical-align:top\">\n        <b>Received By</b><br>{{ doc.received_by or '—' }}\n      </td>\n    </tr>\n    <tr>\n      <td style=\"padding:8px;border:1px solid #e2e6ee\" colspan=\"2\">\n        <b>Delivery Address</b><br>{{ doc.delivery_address or '—' }}\n      </td>\n    </tr>\n    \n  </table>\n\n  {% if doc.delivery_status != 'Failed' %}\n  <table style=\"width:100%;border-collapse:collapse;margin-top:18px\">\n    <tr>\n      <td style=\"width:50%;padding:8px;vertical-align:top\">\n        <b style=\"font-size:13px\">Customer Signature</b><br>\n        {% if doc.signature %}\n          <img src=\"{{ doc.signature }}\" style=\"max-height:140px;border:1px solid #ddd;border-radius:8px;margin-top:6px\">\n        {% else %}<span style=\"color:#bbb\">—</span>{% endif %}\n      </td>\n      <td style=\"width:50%;padding:8px;vertical-align:top\">\n        <b style=\"font-size:13px\">Proof Photo</b><br>\n        {% if doc.proof_photo %}\n          <img src=\"{{ doc.proof_photo }}\" style=\"max-height:140px;max-width:100%;border:1px solid #ddd;border-radius:8px;margin-top:6px\">\n        {% else %}<span style=\"color:#bbb\">—</span>{% endif %}\n      </td>\n    </tr>\n  </table>\n  {% endif %}\n\n  {% if doc.latitude and doc.longitude %}\n  <div style=\"margin-top:18px;font-size:13px;border:1px solid #e2e6ee;border-radius:8px;padding:10px\">\n    <b>Delivery Location</b>\n    <span style=\"color:#4f8cff\">{{ doc.latitude }}&deg;, {{ doc.longitude }}&deg;</span>\n    <span style=\"color:#8a8f98;font-size:12px\">(accuracy \u00b1{{ '%.0f'|format((doc.geo_accuracy or 0)|float) }} m)</span><br>\n    <a href=\"https://maps.google.com/?q={{ doc.latitude }},{{ doc.longitude }}\" style=\"font-size:12px\">Open in Google Maps</a>\n  </div>\n  {% endif %}\n\n  {% if doc.remark %}\n  <div style=\"margin-top:14px;font-size:13px;border:1px solid #e2e6ee;border-radius:8px;padding:10px\">\n    <b>Remark</b><br>{{ doc.remark }}\n  </div>\n  {% endif %}\n\n  <div style=\"margin-top:26px;border-top:1px dashed #d6dae3;padding-top:10px;font-size:12px;color:#8a8f98;display:flex;justify-content:space-between\">\n    <span>Driver: <b>{{ doc.driver }}</b></span>\n    <span>Printed: {{ frappe.utils.now_datetime().strftime('%Y-%m-%d %H:%M') }}</span>\n  </div>\n</div>",
 "doc_type": "Delivery Proof",
 "doctype": "Print Format",
 "font_size": 12,
 "module": "Tameer Delivery",
 "name": "Proof of Delivery",
 "print_format_type": "HTML",
 "standard": "No"
}]